{
  "info": {
    "name": "MultiKoisas API",
    "description": "Todas as rotas da API do back-end (multikoisas-univesp). Rode primeiro \"Login\" com username e password das variáveis da coleção: o token fica salvo e vai sozinho nas rotas que exigem login. Requisições marcadas \"(grava no banco)\" alteram o banco real do time.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://multikoisas-univesp.onrender.com"
    },
    {
      "key": "username",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0 - Login",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.collectionVariables.set('token', pm.response.json().token);"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "1 - Produtos",
      "item": [
        {
          "name": "Listar produtos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produto",
              "host": ["{{baseUrl}}"],
              "path": ["produto"]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Buscar produto por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produto?id=1",
              "host": ["{{baseUrl}}"],
              "path": ["produto"],
              "query": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Criar produto (grava no banco)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produto",
              "host": ["{{baseUrl}}"],
              "path": ["produto"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produto de teste\",\n  \"descricaoProduto\": \"Descrição do produto de teste\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Atualizar produto (grava no banco)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/produto/:id",
              "host": ["{{baseUrl}}"],
              "path": ["produto", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "0"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Produto de teste\",\n  \"descricaoProduto\": \"Descrição nova\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Apagar produto (grava no banco)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/produto/:id",
              "host": ["{{baseUrl}}"],
              "path": ["produto", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "0"
                }
              ]
            }
          }
        }
      ]
    },
